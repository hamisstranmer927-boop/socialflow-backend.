# ═══════════════════════════════════════════
# SocialFlow Backend - Environment Variables
# ═══════════════════════════════════════════

# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=socialflow
DB_USER=socialflow
DB_PASSWORD=dev_password_123
DB_DIALECT=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Firebase (Auth)
# Download service account JSON from Firebase Console
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_STARTER=price_starter_id
STRIPE_PRICE_PROFESSIONAL=price_professional_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_id

# JWT (Fallback auth for dev without Firebase)
JWT_SECRET=socialflow-dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# Social Platform APIs
# Meta (Instagram + Facebook)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:3000/api/social/callback/instagram

# TikTok
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:3000/api/social/callback/tiktok

# File Storage
# For dev: 'local', for production: 's3'
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# AWS S3 (Production)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=socialflow-media

# App URL (for OAuth callbacks)
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:8081
